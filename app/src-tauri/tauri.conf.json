{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arkived",
  "version": "0.0.1",
  "identifier": "io.horizon-tech.arkived",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Arkived",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright (c) 2026 Horizon Tech d.o.o.",
    "category": "DeveloperTool",
    "shortDescription": "Azure Storage client, agent-ready.",
    "longDescription": "Arkived — a fast, Rust-native storage client for Microsoft Azure with MCP and ACP support.",
    "publisher": "Horizon Tech d.o.o.",
    "homepage": "https://arkived.app",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
